<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <ProjectOptions>
    <Version Value="12"/>
    <General>
      <Flags>
        <MainUnitHasCreateFormStatements Value="False"/>
        <MainUnitHasTitleStatement Value="False"/>
        <MainUnitHasScaledStatement Value="False"/>
        <LRSInOutputDirectory Value="False"/>
        <CompatibilityMode Value="True"/>
      </Flags>
      <SessionStorage Value="InProjectDir"/>
    </General>
    <BuildModes Count="1">
      <Item1 Name="default" Default="True"/>
      <SharedMatrixOptions Count="4">
        <Item1 ID="1" Modes="default" Type="IDEMacro" MacroName="LCLWidgetType" Value="qt5"/>
        <Item2 ID="2" Type="IDEMacro" MacroName="LCLWidgetType" Value="qt6"/>
        <Item3 ID="3" Modes="default" Type="IDEMacro" MacroName="LCLWidgetType" Value="gtk2"/>
        <Item4 ID="4" Type="IDEMacro" MacroName="LCLWidgetType" Value="gtk3"/>
      </SharedMatrixOptions>
    </BuildModes>
    <RequiredPackages Count="1">
      <Item1><PackageName Value="LCL"/></Item1>
    </RequiredPackages>
    <Units Count="2">
      <Unit0><Filename Value="pdf-wlx.lpr"/><IsPartOfProject Value="True"/></Unit0>
    </Units>
  </ProjectOptions>
  <CompilerOptions>
    <Version Value="11"/>
    <Target><Filename Value="build/pdf-wlx-$(TargetCPU)-$(TargetOS)-$(LCLWidgetType).wlx" ApplyConventions="False"/></Target>
    <SearchPaths><IncludeFiles Value="sdk"/><OtherUnitFiles Value="sdk"/><UnitOutputDirectory Value="lib/$(LCLWidgetType)"/></SearchPaths>
    <Conditionals Value="if (TargetCPU &lt;&gt; 'arm') then CustomOptions += '-fPIC'; if (TargetOS = 'linux') then LinkerOptions += ' -z relro --as-needed';"/>
    <Parsing><SyntaxOptions><UseAnsiStrings Value="False"/></SyntaxOptions></Parsing>
    <Linking><LinkSmart Value="True"/><Options><PassLinkerOptions Value="True"/><ExecutableType Value="Library"/></Options></Linking>
  </CompilerOptions>
</CONFIG>
